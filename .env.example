STORAGE_BACKEND=file
# Database user from Atlas > Database Access (not your Atlas account login); readWrite on MONGODB_DB only
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=hirewall
