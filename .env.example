LLM_MODEL=qwen3.5:4b
LLM_HOST=http://127.0.0.1:11434
RECRUITER_SIGNATURE=
LLM_API_KEY=
DATABASE_URL=
JWT_SECRET=
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
CALENDAR_PROVIDER=mock
GOOGLE_CLIENT_SECRET_FILE=secrets/client_secret.json
GOOGLE_TOKEN_FILE=secrets/token.json
GOOGLE_CALENDAR_ID=primary
SEND_UPDATES=none
SCHEDULER_TIMEZONE=Africa/Tunis
SCHEDULER_TOKEN_SECRET=
HR_NOTIFICATION_EMAIL=
# Scheduler chat: fake, or openai with a local LLM_BASE_URL (e.g. http://localhost:11434/v1). Cloud APIs are refused.
LLM_PROVIDER=fake
LLM_BASE_URL=
LLM_TIMEOUT=30
LLM_REASONING_EFFORT=
HR_TOKEN_SECRET=
# Named staff accounts (create them with: python scripts/create_user.py). The file holds scrypt hashes, never passwords.
HIREWALL_USERS_FILE=data/runtime/users.json
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
GOOGLE_CALENDAR_EMBED_ID=
CALENDAR_ALLOW_WRITE=false
DEV_MODE=false
PUBLIC_BASE_URL=http://localhost:5173
GATEWAY_PORT=8000
OLLAMA_HOST=http://localhost:11434
LLM_NUM_CTX=8192
LLM_TIMEOUT_SECONDS=120
LLM_THINK=false
FULL_CONTEXT_TOKEN_BUDGET=3000
RETRIEVAL_TOP_K=5
BM25_MIN_SCORE=4.5
KNOWLEDGE_LLM_PROVIDER=
EMAIL_MODE=outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
# Optional: shown in emails and on the candidate page
COMPANY_NAME=
ANALYTICS_AS_OF=2026-11-01
MIN_GROUP_SIZE=5
SCREENER_EMBEDDING_MODEL=intfloat/multilingual-e5-small
# After the first run has downloaded the model, 1 stops all contact with the Hugging Face Hub
# HF_HUB_OFFLINE=1
# sentence-transformers (downloads the model once) or hashing (bag of words, offline demos only)
SCREENER_EMBEDDER=sentence-transformers
SCREENER_WEIGHT_SEMANTIC=0.35
SCREENER_WEIGHT_RUBRIC=0.45
SCREENER_WEIGHT_EXPERIENCE=0.2
SCREENER_WEIGHT_GRAPH=0
SCREENER_AS_OF=2026-01-01
SCREENER_LLM_TIMEOUT_SECONDS=120
SECURITY_MODEL_MODE=off
SECURITY_MODEL_THRESHOLD=0.95
SECURITY_MODEL_FLAG_THRESHOLD=0.6
SECURITY_MODEL_DIR=
SECURITY_QUARANTINE_FILE=

# Storage: file (default, data/runtime) or mongo. Tests always use in-memory storage.
STORAGE_BACKEND=file
# Database user from Atlas > Database Access (not your Atlas account login); readWrite on MONGODB_DB only
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=hirewall

# Gateway hardening
RATE_LIMIT_PER_MINUTE=300
# Routes that run the local model (drafting, scheduler chat, Q&A, screening uploads and runs)
RATE_LIMIT_LLM_PER_MINUTE=12
MAX_BODY_BYTES=1048576
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Only when the site is served over HTTPS
HSTS_ENABLED=false

# Optional antivirus scan of uploads with a local ClamAV (clamd). Fails closed: if on and unreachable, uploads are refused.
# docker run -d --name clamav -p 127.0.0.1:3310:3310 clamav/clamav:stable
CLAMAV_ENABLED=false
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# Retention: scripts/apply_retention.py erases candidates whose process ended more than this many days ago (dry run by default)
RETENTION_DAYS=365
